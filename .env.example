# ---------------------------------------------------------------------------
# PUBLIC values. These ARE shipped to the browser. Safe by design.
# ---------------------------------------------------------------------------

# Production origin. Set in Vercel → Project → Settings → Environment Variables
# (Production) once the real public URL is known, e.g. https://<project>.vercel.app
# While unset, canonical / og:url / sitemap / JSON-LD are omitted on purpose.
VITE_SITE_URL=

# Supabase project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Supabase PUBLISHABLE (anon-class) key. Safe in the browser: every table is protected
# by row-level security. Never use a service-role or secret key here.
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# NEVER put these in any file that is committed or shipped to the browser:
#   - the database password
#   - the service role / secret key (SUPABASE_SERVICE_ROLE_KEY)
#   - JWT signing secrets
#   - user passwords
# The admin panel is designed to run without any of them.
# ---------------------------------------------------------------------------
